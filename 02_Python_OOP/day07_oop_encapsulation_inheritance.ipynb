    "## 🏥 Hospital Management System (Advanced Project)\n",
    "\n",
    "Building a complete hospital system with Doctors and Nurses inheriting from Employee"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "d6c9b948",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "========== Doctor Information ==========\n",
      "Doctor Name: Ali\n",
      "Employee ID: 101\n",
      "Working Hours: 9AM - 5PM\n",
      "Shift Hours: Morning\n",
      "Specialization: Cardiologist\n",
      "Patients Per Day: 20\n",
      "\n",
      "Doctor Shift Updated\n",
      "New Shift: Evening\n",
      "========== Nurse Information ==========\n",
      "Nurse Name: Ayesha\n",
      "Employee ID: 201\n",
      "Working Hours: 9AM - 5PM\n",
      "Shift Hours: Morning\n",
      "Ward Number: 4\n",
      "Shift: Night\n",
      "\n",
