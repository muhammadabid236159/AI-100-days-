   "source": [
    "class Employee:\n",
    "    def __init__(self, name, employee_id, working_hours, shift_hours):\n",
    "        self.name = name\n",
    "        self.employee_id = employee_id\n",
    "        self.working_hours = working_hours\n",
    "        self.shift_hours = shift_hours\n",
    "\n",
    "    def change_shift_time(self, new_shift_time):\n",
    "        self.shift_hours = new_shift_time\n",
    "\n",
    "class Doctor(Employee):\n",
    "    def __init__(self, name, employee_id, working_hours, shift_hours, specialization, patients_per_day):\n",
    "        super().__init__(name, employee_id, working_hours, shift_hours)\n",
    "        self.specialization = specialization\n",
    "        self.patients_per_day = patients_per_day\n",
    "\n",
    "    def show_information(self):\n",
    "        print(\"========== Doctor Information ==========")\n",
    "        print(f\"Doctor Name: {self.name}\")\n",
    "        print(f\"Employee ID: {self.employee_id}\")\n",
    "        print(f\"Working Hours: {self.working_hours}\")\n",
    "        print(f\"Shift Hours: {self.shift_hours}\")\n",
    "        print(f\"Specialization: {self.specialization}\")\n",
    "        print(f\"Patients Per Day: {self.patients_per_day}\")\n",
    "\n",
    "class Nurse(Employee):\n",
    "    def __init__(self, name, employee_id, working_hours, shift_hours, ward_number, shift):\n",
    "        super().__init__(name, employee_id, working_hours, shift_hours)\n",
    "        self.ward_number = ward_number\n",
    "        self.shift = shift\n",
    "\n",
    "    def show_nurse_info(self):\n",
    "        print(\"========== Nurse Information ==========")\n",
    "        print(f\"Nurse Name: {self.name}\")\n",
    "        print(f\"Employee ID: {self.employee_id}\")\n",
    "        print(f\"Working Hours: {self.working_hours}\")\n",
    "        print(f\"Shift Hours: {self.shift_hours}\")\n",
    "        print(f\"Ward Number: {self.ward_number}\")\n",
    "        print(f\"Shift: {self.shift}\")\n",
    "\n",
    "doctor1 = Doctor(\"Ali\", 101, \"9AM - 5PM\", \"Morning\", \"Cardiologist\", 20)\n",
    "nurse1 = Nurse(\"Ayesha\", 201, \"9AM - 5PM\", \"Morning\", 4, \"Night\")\n",
    "\n",
    "doctor1.show_information()\n",
    "print(\"\\nDoctor Shift Updated\")\n",
    "doctor1.change_shift_time(\"Evening\")\n",
    "print(f\"New Shift: {doctor1.shift_hours}\")\n",
    "\n",
    "nurse1.show_nurse_info()\n",
    "print(\"\\nNurse Shift Updated\")\n",
    "nurse1.change_shift_time(\"Morning\")\n",
    "print(f\"New Shift: {nurse1.shift_hours}\")"
   ]
